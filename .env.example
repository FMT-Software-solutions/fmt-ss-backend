# Server
PORT=3001
FRONTEND_URL=http://localhost:3000

# Comma-separated CORS allowlist. Leave empty to allow all origins (dev only).
ADMIN_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,https://fmtsoftware.com,https://admin.fmtsoftware.com

# Expose Swagger at /api/docs in production (defaults to on outside production)
SWAGGER_ENABLED=false

# Sanity Configuration
SANITY_PROJECT_ID=sanity_project_id
SANITY_DATASET=production
SANITY_API_TOKEN=sanity_api_token
SANITY_PREVIEW_SECRET=sanity_preview_secret

# Supabase
SUPABASE_URL=supabase_url_here
SUPABASE_ANON_KEY=supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=supabase_service_role_key_here


# Email Service
RESEND_API_KEY=resend_api_key_here

# App Provisioning Security
PROVISIONING_SECRET=provisioning_secret_here

# Legacy Cloudflare R2 — app-specific account, used by src/modules/files/
CLOUDFLARE_R2_ACCESS_KEY_ID=cloudflare_r2_access_key_id_here
CLOUDFLARE_R2_SECRET_ACCESS_KEY=cloudflare_r2_secret_access_key_here
CLOUDFLARE_R2_ENDPOINT=cloudflare_r2_endpoint_here

# FMT-SS shared Cloudflare R2 — used by src/modules/storage/ for all apps
# (Job Tracker artwork uploads and future org-storage features).
FMTSS_CLOUDFLARE_R2_ACCESS_KEY_ID=fmtss_cloudflare_r2_access_key_id_here
FMTSS_CLOUDFLARE_R2_SECRET_ACCESS_KEY=fmtss_cloudflare_r2_secret_access_key_here
FMTSS_CLOUDFLARE_R2_ENDPOINT=fmtss_cloudflare_r2_endpoint_here
FMTSS_CLOUDFLARE_R2_BUCKET=fmt-software-solutions


HUBTEL_MERCHANT_ACCOUNT=203
HUBTEL_API_ID=hubtel_api_id_here
HUBTEL_API_KEY=hubtel_api_key_here

ADMIN_EMAILS=admin_emails_here_separated_by_comma

# Public ORIGIN of this API — no /api suffix and no trailing slash.
# The code appends /api/sms/webhook/arkesel itself when building the
# Arkesel delivery-report callback, so a value ending in /api produces
# /api/api/... and the receipts 404 silently, leaving SMS status stuck
# at "sent". Without this set at all, receipts are simply not requested.
PUBLIC_API_URL=https://api.fmtsoftware.com

# Paystack publishable key, returned to checkout clients so they can open
# the payment dialog. Safe to expose; the secret key stays server-side.
PAYSTACK_PUBLIC_KEY=pk_live_or_test_key_here

PAYSTACK_SECRET_KEY=paystack_secret_key_here


ARKESEL_API_KEY=your_arkesel_api_key_here

# SMS low-balance alerting
# Master switch: the daily sweep only sends real SMS when this is exactly "true",
# so a local backend never messages customers.
SMS_ALERTS_ENABLED=false
# Warn an organization when its credits fall below this
SMS_LOW_BALANCE_THRESHOLD=20
# Warn the team when FMT's own Arkesel SMS balance falls below this
ARKESEL_MAIN_BALANCE_THRESHOLD=500
# Do not warn the same organization again within this many hours
SMS_ALERT_COOLDOWN_HOURS=72
# Sender ID for alert SMS (falls back to the org's own, then "FMTSoftware").
# Arkesel allows at most 11 characters and the ID must be approved.
SMS_ALERT_SENDER_ID=FMTSoftware

# apps
CHURCH_HUB_SUPABASE_URL=church_hub_supabase_url_here
CHURCH_HUB_SUPABASE_SECRET_KEY=church_hub_supabase_secret_key_here

STOCK_FLOW_SUPABASE_URL=stock_flow_supabase_url_here
STOCK_FLOW_SUPABASE_SECRET_KEY=stock_flow_supabase_secret_key_here

PRINT_CALC_SUPABASE_URL=print_calc_pro_supabase_url_here
PRINT_CALC_SUPABASE_SECRET_KEY=print_calc_pro_supabase_secret_key_here
# Website analytics: how long raw page_views rows are kept before the nightly
# rollup purges them (aggregates in analytics_daily are kept indefinitely)
ANALYTICS_RETENTION_DAYS=90
